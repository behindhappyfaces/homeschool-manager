        { "id": "1-r-2", "text": "Which word has a silent 'e'?", "type": "multiple-choice", "options": ["cat", "bed", "bike", "hop"], "answer": "bike", "skill": "silent-e" },
        { "id": "1-r-3", "text": "What does 'The dog ran fast' tell you?", "type": "multiple-choice", "options": ["The dog is sleeping", "The dog moved quickly", "The dog is eating", "The dog is barking"], "answer": "The dog moved quickly", "skill": "comprehension" },
        { "id": "1-r-4", "text": "Which word is a compound word?", "type": "multiple-choice", "options": ["happy", "running", "sunshine", "jumped"], "answer": "sunshine", "skill": "compound-words" },
        { "id": "1-r-5", "text": "What is the plural of 'box'?", "type": "multiple-choice", "options": ["boxs", "boxes", "boxies", "box"], "answer": "boxes", "skill": "plurals" }
