        { "id": "1-w-2", "text": "Which word is a noun (person, place, or thing)?", "type": "multiple-choice", "options": ["run", "happy", "farm", "quickly"], "answer": "farm", "skill": "parts-of-speech" },
        { "id": "1-w-3", "text": "Which word is a verb (action word)?", "type": "multiple-choice", "options": ["tree", "jump", "blue", "house"], "answer": "jump", "skill": "parts-of-speech" }
      ]
