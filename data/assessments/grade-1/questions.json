        { "id": "1-m-1", "text": "What is 7 + 8?", "type": "multiple-choice", "options": ["13", "14", "15", "16"], "answer": "15", "skill": "addition-to-20" },
        { "id": "1-m-2", "text": "What is 12 - 5?", "type": "multiple-choice", "options": ["6", "7", "8", "9"], "answer": "7", "skill": "subtraction-to-20" },
        { "id": "1-m-3", "text": "Which number is GREATER? 34 or 43?", "type": "multiple-choice", "options": ["34", "43", "They are equal", "I don't know"], "answer": "43", "skill": "place-value" },
        { "id": "1-m-4", "text": "How many tens are in the number 25?", "type": "multiple-choice", "options": ["1", "2", "5", "25"], "answer": "2", "skill": "place-value" },
        { "id": "1-m-5", "text": "What comes next? 5, 10, 15, 20, ___", "type": "multiple-choice", "options": ["22", "24", "25", "30"], "answer": "25", "skill": "skip-counting" },
        { "id": "1-m-6", "text": "It is 2:00. What time will it be in 1 hour?", "type": "multiple-choice", "options": ["1:00", "2:30", "3:00", "4:00"], "answer": "3:00", "skill": "telling-time" }
